# Copy this file to .env. Never commit .env.
# Generate random values with: openssl rand -hex 32

# Required secrets
# Fine-grained GitHub tokens need read access to starred repositories. Classic
# tokens can use public_repo (public stars) or repo (including private repos).
GITHUB_TOKEN=
POSTGRES_PASSWORD=replace-with-a-long-random-password
MEILI_MASTER_KEY=replace-with-at-least-16-bytes
PLATFORM_AGENT_TOKEN=replace-with-a-long-random-token

# Recommended access separation
ADMIN_TOKEN=replace-with-a-separate-long-admin-token
# Must equal AGENT_COMPOSE_AUTH_TOKEN in the agent-compose daemon deployment.
AGENT_COMPOSE_AUTH_TOKEN=replace-with-a-long-random-token

# Agent model
AGENT_PROVIDER=codex
AGENT_MODEL=

# OpenAI-compatible endpoint used by agent-compose. OPENAI_API_KEY is also
# supported by the official image; keep unused provider credentials empty.
LLM_API_ENDPOINT=https://api.openai.com
LLM_API_PROTOCOL=responses
LLM_API_KEY=
OPENAI_API_KEY=

# Agent workflow defaults
PLATFORM_API_URL=http://api:8080
ANALYSIS_VERSION=v1
CURATOR_BATCH_SIZE=10
CURATOR_LOCAL_MAX_CONCURRENCY=8
CURATOR_JOB_TIMEOUT_MS=180000

# Adaptive analysis concurrency (Platform API global limit)
ANALYSIS_MIN_CONCURRENCY=4
ANALYSIS_INITIAL_CONCURRENCY=4
ANALYSIS_MAX_CONCURRENCY=8

# Optional platform overrides (defaults are shown)
# API_BIND_ADDR=127.0.0.1
# API_PORT=8080
# WEB_BIND_ADDR=127.0.0.1
# WEB_PORT=3000
# MEILI_BIND_ADDR=127.0.0.1
# MEILI_PORT=7700
# LOG_LEVEL=info
# VITE_API_BASE_URL=http://localhost:8080
# AGENT_COMPOSE_IMAGE=chaitin/agent-compose:v2608.2.0
# AGENT_COMPOSE_GUEST_IMAGE=chaitin/agent-compose-guest:latest
# AGENT_IMAGE=repo-constellation-agent:local
# AGENT_COMPOSE_DATA_DIR=./.data/agent-compose
